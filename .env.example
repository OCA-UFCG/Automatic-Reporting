# Painel editorial (docs/PLANO-PAINEL-EDITORIAL.md).
# "docs" (padrão) lê a prosa do Google Doc do macrotema; "painel" lê o contrato
# publicado em output/contratos/<slug>.json. A variável por macrotema vence a
# global, para migrar um tema por vez sem afetar os demais.
FONTE_EDITORIAL=docs
# FONTE_EDITORIAL_EDUCACAO=painel
# FONTE_EDITORIAL_DEMOGRAFIA=painel

# Painel editorial — tela de autoria (/painel).
# Sem PAINEL_SENHA o painel não abre. Não há papéis: quem entra, edita e publica.
PAINEL_SENHA=
# Opcional. Sem isto, a chave de assinatura das sessões deriva da senha.
PAINEL_SEGREDO=
